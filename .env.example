# Environment variables obrew reads. obrew does not load this file itself: export them, or let
# the host that spawns obrew set them. Every one is optional.

# The BASELINE model: writes content and narration. A registry id (`obrew models list`).
# Order: --model, then this, then the default chosen with `obrew models use`
# (built-in: unsloth/gemma-4-E2B-it-GGUF:gemma-4-E2B-it-Q8_0.gguf).
# OBREW_MODEL=unsloth/gemma-4-E2B-it-GGUF:gemma-4-E2B-it-Q8_0.gguf

# The TOOL model: turns the baseline model's text into tool calls. `needle3` (the default when
# installed), `none`, or the path of a fine-tuned .cact. Order: -c tool_model=, then this, then
# `obrew models use --tool`.
# OBREW_TOOL_MODEL=needle3

# Experimental: also structure --output-schema answers with the tool model. Off by default.
# OBREW_TOOL_ANSWERS=1

# Where obrew keeps engines, models and sessions.
# OBREW_HOME=

# Default for `exec --engine`: shared (warm, the default) or ephemeral.
# OBREW_ENGINE=shared

# Hugging Face token for gated repos (HF_TOKEN wins), and a Hub mirror.
# OBREW_HF_TOKEN=
# HF_ENDPOINT=

# Explicit binaries. A wrong path is a hard failure, never a silent fall-through.
# OBREW_LLAMA_SERVER=
# OBREW_NEEDLE=
# OBREW_NEEDLE_WEIGHTS=

# A DuckDuckGo-HTML-compatible endpoint for the WebSearch tool.
# OBREW_SEARCH_URL=
